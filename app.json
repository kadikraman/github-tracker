{
  "expo": {
    "name": "GitHubTracker",
    "slug": "GitHubTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "platforms": [
      "macos"
    ],
    "macos": {
      "bundleIdentifier": "dev.kadi.github-tracker"
    },
    "plugins": [
      [
        "expo-desktop-config-plugins",
        {
          "displayName": "GitHub Tracker",
          "bundleIdentifier": "dev.kadi.github-tracker"
        }
      ]
    ]
  }
}